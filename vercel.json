{
  "ignoreCommand": "if [ \"${VERCEL_ENV}\" != \"production\" ]; then case \"${VERCEL_GIT_COMMIT_REF}\" in dependabot/*|cursor/*) exit 0 ;; esac; fi; if ! git rev-parse --verify HEAD^ >/dev/null 2>&1; then exit 1; fi; git diff --quiet HEAD^ HEAD -- .",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "northern-bytes.vercel.app" }],
      "destination": "https://minnyagents.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "northern-bytes.vercel.app" }],
      "destination": "https://minnyagents.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.minnyagents.com" }],
      "destination": "https://minnyagents.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.minnyagents.com" }],
      "destination": "https://minnyagents.com/:path*",
      "permanent": true
    }
  ]
}
